# Line endings: Windows scripts keep CRLF, Mac/Unix scripts keep LF, everything else is normalized.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.command text eol=lf
*.sh text eol=lf

# Dev-only files: left out of the release ZIP (git archive).
.github/ export-ignore
scripts/ export-ignore
CLAUDE.md export-ignore
RELEASING.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore
